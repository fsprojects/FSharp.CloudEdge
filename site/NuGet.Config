<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The site restores from nuget.org only, so CI does not need the repository's local generator feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
