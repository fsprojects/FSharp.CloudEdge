<Project>
  <!--
    Shared settings for the site's example projects. Every F# block on the site is an excerpt of a file
    compiled here, and scripts/check-examples.py verifies that. Build the solution first: the examples
    use the bindings' existing build output instead of rebuilding them.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BuildProjectReferences Condition="'$(BuildProjectReferences)' == ''">false</BuildProjectReferences>
    <CloudEdgeSrc>$(MSBuildThisFileDirectory)../../src/</CloudEdgeSrc>
  </PropertyGroup>
  <!-- Worker-side examples compile with Fable. Set ExampleKind to DotNet for control-plane examples. -->
  <ItemGroup Condition="'$(ExampleKind)' != 'DotNet'">
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Xantham.Fable.Core" Version="0.1.0-local.83b9196820f7e253f211" />
    <PackageReference Include="Xantham.Fable.Core.TS" Version="0.1.0-local.2cc2de89eabe31fc35f6" />
  </ItemGroup>
</Project>
