    <PackageReference Include="FSharp.CloudEdge.Support.AI.V4.Provider" Version="0.1.*" Condition="'$(CloudEdgeUseSource)' != 'true'" />
    <ProjectReference Include="$(CloudEdgeSrc)Support/AI/FSharp.CloudEdge.Support.AI.V4.Provider/FSharp.CloudEdge.Support.AI.V4.Provider.fsproj" Condition="'$(CloudEdgeUseSource)' == 'true'" />
    <PackageReference Include="FSharp.CloudEdge.Support.AI.V4.OpenAICompatible" Version="0.1.*" Condition="'$(CloudEdgeUseSource)' != 'true'" />
    <ProjectReference Include="$(CloudEdgeSrc)Support/AI/FSharp.CloudEdge.Support.AI.V4.OpenAICompatible/FSharp.CloudEdge.Support.AI.V4.OpenAICompatible.fsproj" Condition="'$(CloudEdgeUseSource)' == 'true'" />
    <PackageReference Include="FSharp.CloudEdge.Support.AI.V3.Provider" Version="0.1.*" Condition="'$(CloudEdgeUseSource)' != 'true'" />
    <ProjectReference Include="$(CloudEdgeSrc)Support/AI/FSharp.CloudEdge.Support.AI.V3.Provider/FSharp.CloudEdge.Support.AI.V3.Provider.fsproj" Condition="'$(CloudEdgeUseSource)' == 'true'" />
    <PackageReference Include="FSharp.CloudEdge.Runtime.WorkersAIProvider" Version="0.1.*" Condition="'$(CloudEdgeUseSource)' != 'true'" />
    <ProjectReference Include="$(CloudEdgeSrc)Runtime/AI/FSharp.CloudEdge.Runtime.WorkersAIProvider/FSharp.CloudEdge.Runtime.WorkersAIProvider.fsproj" Condition="'$(CloudEdgeUseSource)' == 'true'" />
    <PackageReference Include="FSharp.CloudEdge.Runtime.AIGatewayProvider" Version="0.1.*" Condition="'$(CloudEdgeUseSource)' != 'true'" />
    <ProjectReference Include="$(CloudEdgeSrc)Runtime/AI/FSharp.CloudEdge.Runtime.AIGatewayProvider/FSharp.CloudEdge.Runtime.AIGatewayProvider.fsproj" Condition="'$(CloudEdgeUseSource)' == 'true'" />
    <PackageReference Include="FSharp.CloudEdge.Runtime.AISearchProvider" Version="0.1.*" Condition="'$(CloudEdgeUseSource)' != 'true'" />
    <ProjectReference Include="$(CloudEdgeSrc)Runtime/AI/FSharp.CloudEdge.Runtime.AISearchProvider/FSharp.CloudEdge.Runtime.AISearchProvider.fsproj" Condition="'$(CloudEdgeUseSource)' == 'true'" />
    <PackageReference Include="FSharp.CloudEdge.Runtime.AIUtils" Version="0.1.*" Condition="'$(CloudEdgeUseSource)' != 'true'" />
    <ProjectReference Include="$(CloudEdgeSrc)Runtime/AI/FSharp.CloudEdge.Runtime.AIUtils/FSharp.CloudEdge.Runtime.AIUtils.fsproj" Condition="'$(CloudEdgeUseSource)' == 'true'" />
    <PackageReference Include="FSharp.CloudEdge.Runtime.AIChat" Version="0.1.*" Condition="'$(CloudEdgeUseSource)' != 'true'" />
    <ProjectReference Include="$(CloudEdgeSrc)Runtime/AI/FSharp.CloudEdge.Runtime.AIChat/FSharp.CloudEdge.Runtime.AIChat.fsproj" Condition="'$(CloudEdgeUseSource)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Summarizer.fs" />
    <Compile Include="DuplicateDetector.fs" />
    <Compile Include="HelpCenterAnswers.fs" />
    <Compile Include="ShopAssistant.fs" />
    <Compile Include="ModelFallback.fs" />
    <Compile Include="MarkdownConverter.fs" />
    <Compile Include="ChatHistoryUpgrade.fs" />
  </ItemGroup>
</Project>
