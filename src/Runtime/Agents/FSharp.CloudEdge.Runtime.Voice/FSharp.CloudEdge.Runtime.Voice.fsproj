<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated by scripts/projects.mjs from config/targets.json. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <NoWarn>$(NoWarn);FS1104</NoWarn>
    <OtherFlags>$(OtherFlags) --maxerrors:20</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FSharp.CloudEdge.Runtime.Voice.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Xantham.Fable.Core" Version="0.2.0" />
    <PackageReference Include="Xantham.Fable.Core.TS" Version="0.4.0-beta.1" />
  </ItemGroup>
</Project>
