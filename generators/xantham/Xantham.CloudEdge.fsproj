<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <XanthamProjectRoot Condition="'$(XanthamProjectRoot)' == ''">$(MSBuildThisFileDirectory)../../../Xantham</XanthamProjectRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <ProjectReference Include="$(XanthamProjectRoot)/src/Xantham.Generator.Myriad/Xantham.Generator.Myriad.fsproj" />
    <ProjectReference Include="$(XanthamProjectRoot)/src/Xantham.Fable.Core/Xantham.Fable.Core.fsproj" />
    <ProjectReference Include="$(XanthamProjectRoot)/src/Xantham.Fable.Core.TS/Xantham.Fable.Core.TS.fsproj" />
  </ItemGroup>
</Project>
